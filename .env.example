# 论文总目录。init/status/gate/rollback 命令收到相对项目名时，会解析到这个目录下。
# 例如 PAPER_WORKFLOW_ROOT=/path/to/paper-projects，
# 则 `python3 scripts/init_paper.py "论文A" ...` 会创建：
# /path/to/paper-projects/论文A/
PAPER_WORKFLOW_ROOT=

# 论文标题。初始化项目时可通过 --title 写入；后续用于 status 输出和阶段产物引用。
PAPER_TITLE=

# 目标会议、期刊、课程或内部交付格式。用于规划页数、格式审查和写作约束。
TARGET_VENUE=

# 页数限制，只写数字。例如 8 表示目标全文 8 页。
PAGE_LIMIT=

# 研究领域或方向。例如 机器学习、网络安全、系统软件、教育技术。
FIELD=

# 论文类型，影响 Stage 3 关卡检查。
# 可选：generic, simulation, ml-experiment, engineering-design, review。
PAPER_PROFILE=generic

# 当前阶段编号：
# 1=选题，2=实验设计，3=实验运行，4=大纲，5=写作，6=审查。
CURRENT_STAGE=1

# 当前阶段中文名称。应与 CURRENT_STAGE 对应，回退脚本会自动更新。
CURRENT_STAGE_NAME=选题

# 作者模式。single 表示单人写作；team 表示多人协作，可在阶段交接时记录负责人。
AUTHOR_MODE=single

# 实验追踪方式。local 表示使用本地 experiment/、stage/ 和日志文件追踪。
EXPERIMENT_TRACKING=local
